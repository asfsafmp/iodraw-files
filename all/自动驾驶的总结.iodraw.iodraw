        <mxCell id="B3caV1MSY92Kg7Ig09u_-103" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;心理学中最近发展区 (ZPD)：&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: initial; font-family: ui-sans-serif, system-ui, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; white-space: pre;&quot;&gt;学习者在当前能力 + 适度引导下，&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: initial; font-family: ui-sans-serif, system-ui, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; white-space: pre;&quot;&gt;能完成 “略超自身水平” 的任务；难度过低无进步，过高学不会。&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: initial; font-family: ui-sans-serif, system-ui, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; white-space: pre;&quot;&gt;将这个理论迁移到自动驾驶中&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;rounded=1;align=center;" parent="1" vertex="1">
          <mxGeometry x="1220" y="1440" width="470" height="80" as="geometry" />
        </mxCell>
        <mxCell id="B3caV1MSY92Kg7Ig09u_-110" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 16px; text-align: left; background-color: initial;&quot;&gt;ZPD-AL 对抗学习框架：双智能体：主车学习安全高效的驾驶；对抗车生成可控的危险场景。为了将难度匹配主车能力&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="1280" y="1540" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="B3caV1MSY92Kg7Ig09u_-113" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;双层约束设计：保证挑战合理且可解&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;主车受安全、效率等约束，对抗车受个人约束、对抗约束、&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: initial; text-align: center; font-size: 16px;&quot;&gt;理想回报上限 (IRC) 约束，避免生成主车无法应对的场景&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="1280" y="1610" width="350" height="90" as="geometry" />
        </mxCell>
        <mxCell id="B3caV1MSY92Kg7Ig09u_-115" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: rgba(0, 0, 0, 0); font-family: ui-sans-serif, system-ui, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; text-align: start;&quot;&gt;车辆潜在威胁等级 (VPTL)&lt;/span&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&amp;nbsp;动态难度调节&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;根据主车指标成功率、碰撞率等进行1000轮的更新一次，变强了对抗车提高难度。&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="1280" y="1710" width="350" height="90" as="geometry" />
        </mxCell>
