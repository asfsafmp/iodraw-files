        <mxCell id="B3caV1MSY92Kg7Ig09u_-29" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;创新点&lt;/font&gt;" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#fa6800;fontColor=#000000;strokeColor=#C73500;" parent="1" vertex="1">
